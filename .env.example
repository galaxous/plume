# Plume unified environment contract
# Copy to .env and adjust per machine/project.

########################################
# Global
########################################
PLUME_APP_NAME=plume
PLUME_ENV=local
PLUME_CONFIG_FILE=./plume.yml
PLUME_STATE_DIR=~/.config/plume/state
PLUME_STATE_DB_FILE=~/.config/plume/state/plume-state.db
PLUME_LOG_DIR=~/.config/plume/logs
PLUME_SITE_RELOAD_REQUIRED=false
PLUME_SITE_RELOAD_VALIDATE=true
PLUME_SITE_NGINX_STRICT=false
# Optional explicit nginx include directory (native strict mode)
PLUME_NGINX_INCLUDE_DIR=
PLUME_SITE_APACHE2_STRICT=false
# Optional explicit apache2 include directory (native strict mode)
PLUME_APACHE2_INCLUDE_DIR=
PLUME_SITE_CADDY_STRICT=false
# Optional explicit caddy include directory (native strict mode)
PLUME_CADDY_INCLUDE_DIR=

########################################
# Project
########################################
PLUME_PROJECT_TYPE=laravel
PLUME_PROJECT_ROOT=/absolute/path/to/project
PLUME_PROJECT_NAME=plume-app
PLUME_PROJECT_DOMAINS=app.test,api.app.test

########################################
# Core toggles (default true)
########################################
PLUME_WEB_SERVER_ENABLED=true
PLUME_WEB_SERVER_DRIVER=nginx
PLUME_WEB_SERVER_VERSION=latest
PLUME_WEB_PORT=80
PLUME_WEB_HTTPS_PORT=443
PLUME_PHP_ENABLED=true
PLUME_PHP_VERSION=8.3
PLUME_PHP_DEFAULT_ALIAS=php
PLUME_PHP_DEFAULT_VERSION=8.3
PLUME_PHP_INSTALLED_VERSIONS=8.1,8.2,8.3
PLUME_PHP_ALIAS_PHP81=8.1
PLUME_PHP_ALIAS_PHP82=8.2
PLUME_PHP_ALIAS_PHP83=8.3
PLUME_PHP_ALIAS_PHP84=8.4
PLUME_PHP_ALIAS_PHP85=8.5
PLUME_PHP_EXTENSIONS_GLOBAL=
PLUME_PHP_EXT_PRESET=none
# Optional per-version preset override list (comma separated): none|laravel-core|queue|media|full
# PLUME_PHP_EXT_PRESET_81=
# PLUME_PHP_EXT_PRESET_82=
# PLUME_PHP_EXT_PRESET_83=
# PLUME_PHP_EXT_PRESET_84=
PLUME_PHP_EXTENSIONS_81=
PLUME_PHP_EXTENSIONS_82=
PLUME_PHP_EXTENSIONS_83=
PLUME_PHP_EXTENSIONS_84=
# Boolean toggles (global or per-version):
# PLUME_PHP_EXT_ENABLE_REDIS=true
# PLUME_PHP_EXT_ENABLE_84_XDEBUG=true
# PLUME_PHP_EXT_DISABLE_84_IMAGICK=true
PLUME_PHP_EXTENSIONS_STRICT=true
PLUME_PHP_EXTENSIONS_AUTO_SYNC=true
# Local dev (Herd-like): sync extensions only for the PHP version being started — faster, fewer pecl failures.
# Use matrix only when you routinely switch PHP versions and need every installed version kept in sync.
PLUME_PHP_EXTENSIONS_AUTO_SYNC_PROFILE=target
PLUME_PHP_EXT_INSTALL_DRIVER=
PLUME_COMPOSER_ENABLED=true
PLUME_COMPOSER_VERSION=latest
PLUME_MARIADB_ENABLED=true
PLUME_MARIADB_VERSION=11.0
PLUME_MARIADB_PORT=3306

########################################
# Optional service toggles (default false)
########################################
PLUME_MYSQL_ENABLED=false
PLUME_MYSQL_VERSION=8.0
PLUME_MYSQL_PORT=3306
PLUME_PHPMYADMIN_ENABLED=false
PLUME_PHPMYADMIN_VERSION=latest
# phpmyadmin host port (container internal 80)
PLUME_PHPMYADMIN_PORT=8081
PLUME_POSTGRES_ENABLED=false
PLUME_POSTGRES_VERSION=16
PLUME_POSTGRES_PORT=5432
PLUME_REDIS_ENABLED=false
PLUME_REDIS_VERSION=7
PLUME_REDIS_PORT=6379
PLUME_REDIS_PASSWORD=secret_redis
PLUME_MEMCACHED_ENABLED=false
PLUME_MEMCACHED_VERSION=1.6
PLUME_MEMCACHED_PORT=11211
PLUME_RABBITMQ_ENABLED=false
PLUME_RABBITMQ_VERSION=3.13
PLUME_RABBITMQ_PORT=5672
PLUME_RABBITMQ_MANAGEMENT_PORT=15672
PLUME_RABBITMQ_USER=guest
PLUME_RABBITMQ_PASSWORD=guest
PLUME_MONGODB_ENABLED=false
PLUME_MONGODB_VERSION=7
PLUME_MONGODB_PORT=27017
PLUME_MONGODB_USERNAME=root
PLUME_MONGODB_PASSWORD=example
PLUME_MONGODB_DATABASE=admin
PLUME_MONGO_WEBUI_ENABLED=false
PLUME_MONGO_WEBUI_VERSION=latest
PLUME_MONGO_WEBUI_PORT=8082
# PLUME_MONGO_WEBUI_URI=mongodb://root:example@127.0.0.1:27017/admin
PLUME_MONGO_WEBUI_USERNAME=admin
PLUME_MONGO_WEBUI_PASSWORD=pass
PLUME_REDIS_WEBUI_ENABLED=false
PLUME_REDIS_WEBUI_VERSION=latest
PLUME_REDIS_WEBUI_PORT=8083
PLUME_REDIS_WEBUI_USERNAME=laradock
PLUME_REDIS_WEBUI_PASSWORD=laradock
PLUME_REDIS_WEBUI_HOST=127.0.0.1
PLUME_REDIS_WEBUI_REDIS_PORT=6379
PLUME_MAILPIT_ENABLED=false
PLUME_MAILPIT_VERSION=latest
PLUME_MAILPIT_PORT=8025
PLUME_MEILISEARCH_ENABLED=false
PLUME_MEILISEARCH_VERSION=1.8
PLUME_MEILISEARCH_PORT=7700
PLUME_MINIO_ENABLED=false
PLUME_MINIO_PORT=9000

########################################
# Laravel runtime
########################################
PLUME_SUPERVISOR_ENABLED=false
PLUME_SUPERVISOR_VERSION=latest
PLUME_HORIZON_ENABLED=false
PLUME_HORIZON_VERSION=latest
PLUME_HORIZON_REQUIRE_SUPERVISOR=true
PLUME_PHP_WORKER_ENABLED=false
PLUME_PHP_WORKER_VERSION=latest
PLUME_SCHEDULER_ENABLED=true
PLUME_QUEUE_ENABLED=true
PLUME_QUEUE_DRIVER=redis
PLUME_OCTANE_ENABLED=false
PLUME_REVERB_ENABLED=false

########################################
# Reconcile behavior
########################################
PLUME_SERVICES_PROFILE=minimal-default
PLUME_RECONCILE_ON_UPDATE=true
PLUME_RECONCILE_INSTALL_ON_ENABLE=true
PLUME_RECONCILE_START_ON_ENABLE=true

########################################
# Security/ops
########################################
PLUME_TLS_ENABLED=true
PLUME_TLS_STRATEGY=auto
PLUME_SECRETS_ENABLED=true
PLUME_SECRETS_FILE=/etc/plume/secrets.env
PLUME_ROLLBACK_ENABLED=true
PLUME_BACKUP_DIR=/var/backups/plume
PLUME_FIREWALL_CHECKS=true
PLUME_OS_SECURITY_CHECKS=true

########################################
# Mode-specific: native
########################################
PLUME_NATIVE_USE_SYSTEMD=true
PLUME_NATIVE_SUDO_REQUIRED=true
# Opt-in: gercek host package install/start/stop (nginx, mariadb, mysql, redis, apache2)
PLUME_NATIVE_HOST_PROVISION=false
# Phase 17: enabled native services auto host install+start on `services up` (default true)
PLUME_NATIVE_SERVICE_AUTO_PROVISION=true
# Native site publish --reload: nginx yoksa otomatik kur/baslat (brew/apt; macOS'ta brew gerekir)
PLUME_SITE_AUTO_PROVISION_WEB=true
# publish --reload: snippet'i Homebrew nginx servers/ altina yaz + nginx -t + reload
PLUME_SITE_NGINX_STRICT_ON_RELOAD=true
# macOS Homebrew nginx varsayilan HTTP portu (site kaydi 80 ise render'da 8080 kullanilir)
# PLUME_NATIVE_HOMEBREW_HTTP_PORT=8080
# Ana nginx.conf listen portunu Plume ile yonet (opt-in; bkz. docs/commands/services-web.md)
# PLUME_NATIVE_NGINX_MANAGE_MAIN_CONFIG=true
# PLUME_NATIVE_NGINX_HTTP_PORT=80
# PLUME_NATIVE_NGINX_MAIN_CONF=/opt/homebrew/etc/nginx/nginx.conf

########################################
# Mode-specific: docker-lite
########################################
PLUME_DOCKER_LITE_ENABLED=false
PLUME_DOCKER_LITE_PROJECT_NAME=plume-app
PLUME_DOCKER_LITE_WORKSPACE_MOUNT=/var/www
PLUME_DOCKER_LITE_UID=1000
PLUME_DOCKER_LITE_GID=1000
WORKSPACE_USER=plume
WORKSPACE_PUID=1000
WORKSPACE_PGID=1000
WORKSPACE_TIMEZONE=UTC
WORKSPACE_INSTALL_ZSH=false
WORKSPACE_INSTALL_OH_MY_ZSH=false
WORKSPACE_INSTALL_NODE=false
WORKSPACE_NODE_VERSION=20
WORKSPACE_NPM_REGISTRY=
WORKSPACE_NVM_NODEJS_ORG_MIRROR=
PLUME_DOCKER_LITE_CERT_HELPER=optional
# compose path is managed via global mode/path state (mode path set ...)
PLUME_DOCKER_LITE_COMPOSE_REQUIRED=false
PLUME_APP_ROOT=./
PLUME_DOCKER_LITE_NGINX_CONF=./conf/nginx.conf
PLUME_DOCKER_LITE_APACHE_CONF=./conf/apache2.conf
PLUME_DOCKER_LITE_CADDYFILE=./conf/Caddyfile
PLUME_DOCKER_LITE_WEB_SERVICE=nginx
PLUME_DOCKER_LITE_PHP_SERVICE=php-fpm
PLUME_DOCKER_LITE_WORKSPACE_SERVICE=workspace
PLUME_DOCKER_LITE_MARIADB_SERVICE=mariadb
PLUME_DOCKER_LITE_MYSQL_SERVICE=mysql
PLUME_DOCKER_LITE_PHPMYADMIN_SERVICE=phpmyadmin
PLUME_DOCKER_LITE_POSTGRES_SERVICE=postgres
PLUME_DOCKER_LITE_REDIS_SERVICE=redis
PLUME_DOCKER_LITE_MEMCACHED_SERVICE=memcached
PLUME_DOCKER_LITE_RABBITMQ_SERVICE=rabbitmq
PLUME_DOCKER_LITE_MONGODB_SERVICE=mongodb
PLUME_DOCKER_LITE_MONGO_WEBUI_SERVICE=mongo-express
PLUME_DOCKER_LITE_MAILPIT_SERVICE=mailpit
PLUME_DOCKER_LITE_MEILISEARCH_SERVICE=meilisearch
PLUME_DOCKER_LITE_MINIO_SERVICE=minio
PLUME_DOCKER_LITE_SUPERVISOR_SERVICE=laravel-horizon
PLUME_DOCKER_LITE_HORIZON_SERVICE=laravel-horizon
PLUME_DOCKER_LITE_PHP_WORKER_SERVICE=php-worker

# Optional docker-lite image overrides (shared PLUME_* versions stay primary)
# PLUME_DOCKER_LITE_WORKSPACE_IMAGE=composer:2
# PLUME_DOCKER_LITE_PHP_FPM_IMAGE=php:8.3-fpm-alpine
# PLUME_DOCKER_LITE_PHP81_IMAGE=php:8.1-fpm-alpine
# PLUME_DOCKER_LITE_PHP82_IMAGE=php:8.2-fpm-alpine
# PLUME_DOCKER_LITE_PHP83_IMAGE=php:8.3-fpm-alpine
# PLUME_DOCKER_LITE_PHP84_IMAGE=php:8.4-fpm-alpine
# PLUME_DOCKER_LITE_NGINX_IMAGE=nginx:stable-alpine
# PLUME_DOCKER_LITE_APACHE_IMAGE=httpd:2.4-alpine
# PLUME_DOCKER_LITE_CADDY_IMAGE=caddy:2-alpine
# PLUME_DOCKER_LITE_MARIADB_IMAGE=mariadb:11
# PLUME_DOCKER_LITE_MYSQL_IMAGE=mysql:8.4
# PLUME_DOCKER_LITE_PHPMYADMIN_IMAGE=phpmyadmin:latest
# PLUME_DOCKER_LITE_POSTGRES_IMAGE=postgres:16-alpine
# PLUME_DOCKER_LITE_REDIS_IMAGE=redis:7-alpine
# PLUME_DOCKER_LITE_HORIZON_IMAGE=laradock/laravel-horizon:latest

########################################
# Mode-specific: laradock-bridge
########################################
PLUME_LARADOCK_BRIDGE_ENABLED=false
# laradock path is managed via global mode/path state (mode path set ...)
PLUME_LARADOCK_AUTO_DISCOVER=true
PLUME_LARADOCK_STRICT=false
PLUME_LARADOCK_COMPOSE_FILE=
PLUME_LARADOCK_PHPMYADMIN_SERVICE=phpmyadmin

########################################
# PMA (mysql/mariadb selector)
########################################
# Accepted values: mariadb | mysql
PMA_DB_ENGINE=mariadb
# Optional alias of PMA_DB_ENGINE
PMA_ENGINE=
PMA_HOST=
PMA_USER=default
PMA_PASSWORD=secret
PMA_ROOT_PASSWORD=secret
PMA_PORT=8081
PMA_MAX_EXECUTION_TIME=600
PMA_MEMORY_LIMIT=256M
PMA_UPLOAD_LIMIT=2G
