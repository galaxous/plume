# Plume native stack manifest (Laradock-style central config).
# Copy to ~/.config/plume/services.yml (or set PLUME_SERVICES_MANIFEST_FILE).
# Merge order: built-in defaults → this file → ~/.config/plume/.env (env wins).
# ${VAR} placeholders resolve from Laradock-style env at manifest load; .env overrides after.

version: 1

services:
  web:
    engine: nginx
    manage_main_config: false
    http_port: 80
    auto_provision: true
    enabled: true

  php:
    enabled: true
    default_version: "8.3"
    versions:
      - "8.1"
      - "8.2"
      - "8.3"
    extensions_profile: matrix

  database:
    engine: mariadb   # mariadb | mysql — native brew: ONE engine only (not both enabled)
    version: "11.0"
    auto_start: true

  redis:
    enabled: "${REDIS_ENABLED}"

  composer:
    enabled: "${COMPOSER_ENABLED}"
  phpmyadmin:
    enabled: "${PHPMYADMIN_ENABLED}"   # native Phase 17: brew/php built-in or apt phpmyadmin
  mariadb:
    enabled: "${MARIADB_ENABLED}"
  mysql:
    enabled: "${MYSQL_ENABLED}"
  postgres:
    enabled: "${POSTGRES_ENABLED}"
    version: "16"
  pgadmin:
    enabled: "${PGADMIN_ENABLED}"   # native: pip pgadmin4 in state venv; Laradock pgadmin parity
  memcached:
    enabled: "${MEMCACHED_ENABLED}"
  rabbitmq:
    enabled: "${RABBITMQ_ENABLED}"
  mongodb:
    enabled: "${MONGODB_ENABLED}"
  mongo_webui:
    enabled: "${MONGO_WEBUI_ENABLED}"
  redis_webui:
    enabled: "${REDIS_WEBUI_ENABLED}"   # native: redis-commander (npm); Laradock alias redis-webui
  mailpit:
    enabled: "${MAILPIT_ENABLED}"   # native: macOS brew install/start; Linux → docker-lite or manual
  meilisearch:
    enabled: "${MEILISEARCH_ENABLED}"
  minio:
    enabled: "${MINIO_ENABLED}"
  supervisor:
    enabled: "${SUPERVISOR_ENABLED}"
  horizon:
    enabled: "${HORIZON_ENABLED}"
  php_worker:
    enabled: "${PHP_WORKER_ENABLED}"

  # Laradock-bridge compose aliases (informational; ignored in native-only mode):
  # workspace:
  #   mode: laradock-bridge
  #   enabled: false   # maps to composer/workspace
  # php-fpm:
  #   mode: laradock-bridge
  #   enabled: false   # maps to php service in compose

  provision:
    on_first_run: true
    interactive: true
